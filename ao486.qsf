# --------------------------------------------------------------------------
#
# MiSTer project
#
# WARNING WARNING WARNING:
# Do not add files to project in Quartus IDE! It will mess this file!
# Add the files manually to files.qip file.
#
# --------------------------------------------------------------------------

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# iter-194 (2026-06-03): capped from ALL (32 cores) -> 8. Two hard machine crashes
# occurred during quartus_fit with ALL cores pinned at 100% for 30+ min (thermal/
# power/RAM). Fit barely scales past ~8 cores; capping trades a little speed for
# stability. Raise back to ALL if the crashes turn out to be unrelated.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS OFF
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS "SPARSE AUTO"
# iter-194 (2026-06-03): AREA pivot. The full transcendental group placed at 98.8%
# ALM and FAILED TO ROUTE (err170143) — a density/congestion wall, not LAB overflow.
# Silicon runs at 56 MHz (huge slack vs the 90 MHz these knobs chase), so trade the
# timing-driven logic/register REPLICATION back for area + routability. KEEP retiming
# (line below; load-bearing for non-FPU paths per iter-165d) and the *_FOR_AREA /
# REMOVE_REDUNDANT options ON. To revert to the 90 MHz set: LCELL_INSERTION->ON,
# COMBO_LOGIC->ON, EFFORT->EXTRA, REGISTER_DUPLICATION->ON, TECHNIQUE->SPEED, plus
# ASYNC_PIPELINING->ON and ROUTER_REGISTER_DUPLICATION->ON further down.
# iter-194b: kept ON (router-side congestion tool). Turning it OFF with the AREA
# synthesis made the router THRASH 6h on routing; the area win comes from synthesis
# (OPTIMIZATION_TECHNIQUE AREA + physical-synth off), not from starving the router.
# iter-196b (2026-06-04): TECHNIQUE AREA -> SPEED + COMBO_LOGIC ON.  AREA was only ever a
# crutch for the 92% route-thrash (iter-194/195); NOHDMI dropped us to 88% AND physically
# removed the congested ascal neighbour, so AREA is no longer needed and was actively
# poisoning CPU timing: the iter-196 AREA build ROUTED but STA showed a -28.7 ns single-cycle
# wall on cs_cache->mc_eip (58 logic levels, 54 ns) — AREA left that combinational cone
# unrestructured.  Under SPEED the SAME path closed <11 ns at iter-165/166 (met 90 MHz on the
# CPU).  Keep the *_FOR_AREA / REMOVE_REDUNDANT options below ON to cap area regrowth so it
# still routes at ~88-90%.  REGISTER_DUPLICATION/ASYNC_PIPELINING left OFF (area).  Revert to
# AREA only if SPEED fails to route.
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
# iter-196c: EFFORT NORMAL->EXTRA + REGISTER_DUPLICATION ON to attack the residual
# decoder->microcode wall (-13.2 ns @56.25). Affordable now (89% ALM, congestion low).
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT EXTRA
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING OFF
# iter-172c (2026-06-01): SEED 3,4 fit RED on LAB density (19, 21 LABs short
# at 95% ALM with sound block restored).  LOW->MEDIUM densifies ALM packing
# (more registers per ALM, fewer LABs).  Timing risk: minor — current wall
# is at int_to_floatx80 ShiftLeft cones, not register-packing-sensitive paths.
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT MEDIUM
set_global_assignment -name OPTIMIZE_POWER_DURING_SYNTHESIS OFF
set_global_assignment -name ROUTER_REGISTER_DUPLICATION ON
# iter-193 NOTE: tried NEVER to pack tighter for the last 5 LABs — BACKFIRED
# (4196->4211, ALMs rose 41482->41647: physical synthesis spread more to
# compensate). Reverted to ALWAYS (the 4196 best). High-density fitter knobs are
# non-monotone here; the working lever for the last LABs is the SEED below.
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
# PR-2c.9 (iter 164): full-FPU build fits on resources (94% ALM, 84% M10K) but
# fit RED on localized routing congestion (peak 69% interconnect, region
# X22-X32/Y46-Y57). Aggressive routability is already ALWAYS (line 54), so the
# remaining Quartus-recommended remedy is a fresh fitter seed. Keeps full FPU +
# full 128KB L2; if this still congests, next escalation is L2 -> 64KB.
set_global_assignment -name SEED 4

# PR-2c.15 (iter 165d): keep register retiming ON globally (line 38 — an upstream MiSTer
# HIGH-PERFORMANCE setting the NON-FPU paths need: a global OFF closed the FPU but
# regressed l2_cache read_addr/ram_addr (-19.8 ns) and tlb|linear, which are real
# single-cycle paths retiming was pipelining and CANNOT be multicycled).  Retiming's only
# harm is pulling the FPU multicycle-destination flops BACKWARD into their deep source
# cones (esp. b_lat into the bcd_to_int64 18-term multiply cone), splitting each
# multicycle path (e.g. -from mem_data_lat -to b_lat) so NEITHER segment matches the
# set_multicycle_path endpoints and the retimed segment is checked SINGLE-cycle (STA:
# b_lat via bcd_to_int64|Add0~1_OTERM... = -32 ns; b_lat was the SOLE failure with
# retiming on).  Per-instance ALLOW_REGISTER_RETIMING -to is rejected by 17.0 Lite (err
# 125024), but PRESERVE_REGISTER ON IS node-level and the fitter does NOT retime a
# preserved register — so pin exactly the deep FPU multicycle flops.  These are simple
# flops (NOT the regfile/csr RAM, which inferred fine and passed), clocked only after the
# S_ARITHWAIT / wait states, so preserving them costs nothing and lets the SDC multicycle
# exceptions survive.  Retiming stays ON everywhere else (l2_cache, tlb, etc).
set_instance_assignment -name PRESERVE_REGISTER ON -to "*u_execute_fpu|b_lat*"
set_instance_assignment -name PRESERVE_REGISTER ON -to "*u_execute_fpu|z_lat*"
set_instance_assignment -name PRESERVE_REGISTER ON -to "*u_execute_fpu|flags_lat*"
set_instance_assignment -name PRESERVE_REGISTER ON -to "*write_inst|wr_fpu_store_data*"
set_instance_assignment -name PRESERVE_REGISTER ON -to "*write_inst|wr_fpu_eflags_value*"
# PR-2c.17 (iter 165g): the divider's registered divisor/numerator (fed by the deep
# floatx80_normalize cone, captured once in D_SETTLE and multicycled -setup 3) — keep
# the fitter from retiming them back into the cone and re-splitting the relaxed path.
set_instance_assignment -name PRESERVE_REGISTER ON -to "*u_div|num_reg*"
set_instance_assignment -name PRESERVE_REGISTER ON -to "*u_div|den_reg*"

set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

#enable it only if 8bit indexed mode is used in core
set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"

#set_global_assignment -name VERILOG_MACRO "MISTER_DUAL_SDRAM=1"

# PR-2c.9 (iter 164): full-FPU fit, option (a). The complete x87 FPU is the
# priority; HDMI scaler (ascal, ~2,309 ALM) is dropped to make room. Analog VGA
# output still works. Paired with SB/OPL audio removal in system.v.
#do not enable DEBUG_NOHDMI in release!
#
# iter-167c (2026-05-31): RESTORED ascal. iter-165/166 work shed ~1,200 ALMs
# of headroom; ascal restoration should land at ~96.7% (40,544/41,910). This
# brings HDMI + OSD + screenshot mechanism back online so we can actually
# observe whether iter-166e is silicon-good. SoundBlaster remains dropped
# (no room for both). Re-enable line below if a future iter regresses area
# and we need NOHDMI again as an escape hatch.
#
# iter-196 (2026-06-04): RE-ENABLED. The full x87 transcendental FPU + core
# PLACES at ~92% ALM but will NOT ROUTE (localized congestion in the execute_fpu
# cone). NOHDMI drops ascal + HDMI compositor (~2.3-2.8k ALM) to de-densify the
# hot region. VERIFIED against sys_top.v: the analog VGA OSD is a SEPARATE
# compositor (vga_osd, sys_top.v:1388) OUTSIDE the NOHDMI guard, so the MENU/F12
# overlay STILL works on the DE10-nano analog VGA output. Only HDMI output +
# screenshots are lost (we run analog VGA anyway). Revert: re-comment this line.
set_global_assignment -name VERILOG_MACRO "MISTER_DEBUG_NOHDMI=1"

# PR-2c.8 (iter 161): disable ascal's adaptive (polyphase) scaler to reclaim
# ALMs for the x87 FPU fit.  HDMI output still works (nearest-neighbour scaling
# instead of HQ/polyphase); far less drastic than DEBUG_NOHDMI.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

# iter-167c (2026-05-31): drop alsa non-SB audio path (~260 ALMs) to close
# the 24-LAB gap when restoring ascal. SoundBlaster + OPL3 remain (those
# live in system.v's sound block, also dropped in iter-164 — separate
# decision). alsa was the I2S non-SB audio path nothing in current testing
# exercises.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

# AUDIO_SILENT (iter-193): the single switch that frees area for the FULL x87
# transcendental FPU by making audio "present but silent":
#   * opl3_pkg.sv  -> INSTANTIATE_CHANNELS=0 : drops the OPL3 FM operator datapath
#     (~1.1k ALUTs) but KEEPS host_if + timers, so Adlib still DETECTS (port 388h
#     status still transitions 0x00->0xC0). SoundBlaster DSP/DMA/IRQ are untouched,
#     so SB also detects and transfers complete (no detection hangs).
#   * sys_top.v    -> drops the audio_out output stage (~1.4k ALUTs); audio pins
#     tied to silence.
# Net ~2.5k ALUTs freed -> the full transcendental group fits. Comment this line
# out (or set 0) to restore full audio (then the full FPU build will not fit).
set_global_assignment -name VERILOG_MACRO "AUDIO_SILENT=1"

# NO_MT32PI (iter-193): gate out the MT-32-pi MIDI synth (~215 ALUTs) to recover
# the last ~7 LABs the full transcendental FPU needs (build was 4196/4191, 5 over).
# MT-32-pi needs a Raspberry Pi daughterboard; all its outputs are tied to idle in
# ao486.sv. OPL/SB and normal MPU-401 MIDI are unaffected. Comment out to restore.
set_global_assignment -name VERILOG_MACRO "NO_MT32PI=1"

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:sys/build_id.tcl"
